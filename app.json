{
  "expo": {
    "name": "SmartPocket",
    "slug": "smartpocket-app",
    "scheme": "smartpocket",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#5A67D8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kunalx07.smartpocketapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5A67D8"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.kunalx07.smartpocketapp",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      "expo-image-picker",
      "expo-share-intent"
    ],
    "extra": {
      "eas": {
        "projectId": "f08ca885-ecd9-4efb-9362-21ef28b2253c"
      }
    }
  }
}
